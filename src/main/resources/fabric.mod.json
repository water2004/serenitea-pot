{
  "schemaVersion": 1,
  "id": "serenitea_pot",
  "version": "${version}",
  "name": "尘歌壶",
  "description": "Server-side personal three-realm Serenitea Pots with isolated state and performance budgets.",
  "authors": ["EDTP"],
  "icon": "assets/serenitea_pot/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "default",
        "value": "org.edtp.sereniteapot.SereniteaPotMod"
      }
    ]
  },
  "mixins": [
    "serenitea_pot.mixins.json",
    "serenitea_pot.worldthreader.mixins.json",
    "serenitea_pot.tpc.mixins.json",
    "serenitea_pot.carpet.mixins.json"
  ],
  "suggests": {
    "worldedit": ">=7.2.2 <=7.4.6",
    "axiom": ">=6.1.1 <=6.1.3",
    "worldthreader": "=3.2.0"
  },
  "breaks": {
    "worldthreader": ["<3.2.0", ">3.2.0"]
  },
  "depends": {
    "minecraft": "~${minecraft_version}",
    "fabricloader": ">=0.20.1",
    "fabric-api": "=0.165.0+26.3",
    "fabric-permissions-api-v0": ">=0.7.0",
    "fabric-language-kotlin": ">=1.14.1+kotlin.2.4.20",
    "arcade-dimensions": "=0.14.0-beta.21+26.3"
  }
}
