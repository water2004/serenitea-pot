{
  "schemaVersion": 1,
  "id": "serenitea_pot",
  "version": "${version}",
  "name": "尘歌壶",
  "description": "Server-side personal three-realm Serenitea Pots with isolated state and performance budgets.",
  "authors": ["EDTP"],
  "icon": "assets/serenitea_pot/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "default",
        "value": "org.edtp.sereniteapot.SereniteaPotMod"
      }
    ]
  },
  "mixins": [
    "serenitea_pot.mixins.json",
    "serenitea_pot.worldthreader.mixins.json"
  ],
  "suggests": {
    "worldedit": ">=7.2.2 <=7.4.5",
    "axiom": ">=5.0.0 <=6.0.0",
    "worldthreader": "=3.1.0"
  },
  "breaks": {
    "worldthreader": ["<3.1.0", ">3.1.0"]
  },
  "depends": {
    "minecraft": "~${minecraft_version}",
    "fabricloader": ">=0.19.3",
    "fabric-api": "=0.158.0+26.2",
    "fabric-permissions-api-v0": ">=0.7.0",
    "fabric-language-kotlin": ">=1.13.12+kotlin.2.4.0",
    "arcade-dimensions": "=0.13.0-beta.6+26.2"
  }
}
